{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NeoEE",
  "version": "0.2.0",
  "identifier": "jmf.alex.neoee",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "dist",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "NeoEE",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#000000"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
